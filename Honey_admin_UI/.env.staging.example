# Staging Admin UI — https://ecadmin.indiprotechnologies.com/
# Copy to .env before `npm run build` on staging.

# Must include /api/admin
VITE_API_BASE=https://ecdemoapi.indiprotechnologies.com/api/admin

# Optional — image host (defaults to API host derived from VITE_API_BASE)
VITE_DASHBOARD_URL=https://ecdemoapi.indiprotechnologies.com/

VITE_SECRECT_KEY=change-me-staging-app-secret
