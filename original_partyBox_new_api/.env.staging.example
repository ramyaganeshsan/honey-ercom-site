# Staging API — https://ecdemoapi.indiprotechnologies.com/
# Copy to .env on the staging server (do not commit real secrets).

PORT=5000
NODE_ENV=production

JWT_SECRECT=change-me-staging-jwt-secret
APP_SECRECT_KEY=change-me-staging-app-secret

MONGODB_URI=mongodb://127.0.0.1:27017/honey_ecommerce
DATABASE_NAME=honey_ecommerce

LOG_BACKUP=15d

# BOTH must be the API host (not admin UI). Trailing slash required.
# Used for product/banner image URLs: .../cloud/uploads/...
API_URL=https://ecdemoapi.indiprotechnologies.com/
DASHBOARD_URL=https://ecdemoapi.indiprotechnologies.com/
# Optional:
# ASSETS_URL=https://ecdemoapi.indiprotechnologies.com/

TOKEN=
