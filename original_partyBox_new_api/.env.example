# Copy to .env and fill values for local demo

# Basic config
PORT=5000

# JWT secret (required for admin + storefront login tokens)
# Without this, login returns HTTP 200 but no token → "no token returned from server"
JWT_SECRECT=local-dev-jwt-secret

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/honey_ecommerce
DATABASE_NAME=honey_ecommerce

# Log backup
LOG_BACKUP=15d

# Environment
NODE_ENV=development

# Server URL — use API host for local images (must NOT end with /public)
# Staging: https://ecdemoapi.indiprotechnologies.com/
DASHBOARD_URL=http://localhost:5000/
API_URL=http://localhost:5000/
# Optional override for public images only:
# ASSETS_URL=http://localhost:5000/

APP_SECRECT_KEY=local-dev-secret

# Payment Token
TOKEN=
