# Staging storefront — https://ecdemo.indiprotechnologies.com/
# Copy to .env / .env.production before `npm run build` on staging.

# API base — include /api
VITE_BASE_URL=https://ecdemoapi.indiprotechnologies.com/api

# Public/static assets from API (theme icons, no_image, etc.)
VITE_ASSETS_URL=https://ecdemoapi.indiprotechnologies.com/public

VITE_SITE_NAME=Thunayyan Honey UAE
# Must match API APP_SECRECT_KEY
VITE_SECRECT_KEY=change-me-staging-app-secret

VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECTURL=https://ecdemo.indiprotechnologies.com
VITE_FACEBOOK_APP_ID=
VITE_FACEBOOK_REDIRECTURL=https://ecdemo.indiprotechnologies.com

VITE_FRONT_END_BASE_URL=https://ecdemo.indiprotechnologies.com
